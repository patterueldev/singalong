# Singalong Master Service - Environment Configuration

# Application Settings
DEBUG=True
PORT=5001
HOST=0.0.0.0

# API Key(s) for Node authentication (comma-separated for multiple keys)
# Generate secure random keys (min 32 characters each)
# Example: MASTER_API_KEY=key1-secret-api-key-min-32-chars,key2-secret-api-key-min-32-chars
MASTER_API_KEY=your-secret-api-key-min-32-chars-replace-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
