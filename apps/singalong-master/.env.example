# Singalong Master Service - Environment Configuration

# Application Settings
DEBUG=True
PORT=5001
HOST=0.0.0.0

# API Key(s) for Node authentication (comma-separated for multiple keys)
# Minimum 8 characters per key, but use secure random keys in production
# Example: MASTER_API_KEY=key1-prod-secret,key2-prod-secret
MASTER_API_KEY=your-secret-api-key-replace-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
