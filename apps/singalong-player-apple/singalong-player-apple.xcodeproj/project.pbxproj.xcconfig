// Project build settings for SingalongPlayer
// Generated Xcode project configuration

PRODUCT_NAME = SingalongPlayer
PRODUCT_BUNDLE_IDENTIFIER = com.nicenature.singalong-player
DEVELOPMENT_TEAM = 
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0
TVOS_DEPLOYMENT_TARGET = 16.0

SWIFT_VERSION = 5.9
SWIFT_OBJC_BRIDGING_HEADER = 

CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
PROVISIONING_PROFILE_SPECIFIER = 

ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
GENERATE_INFOPLIST_FILE = NO

// Networking
ALLOWED_NETWORK_PORTS = 5002

// Info.plist location
INFOPLIST_FILE = SingalongPlayer/Info.plist
INFOPLIST_KEY_NSBonjourServices[sdk=*] = _singalong-node._tcp
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Singalong Player needs to discover karaoke nodes on your local network
INFOPLIST_KEY_NSBonjourUsageDescription = Singalong Player discovers karaoke nodes using Bonjour (mDNS)

// UI settings
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
