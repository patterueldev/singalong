# Singalong Production Release - Master Environment Template
# Copy this file to .env and fill in your production values

# Image Configuration
IMAGE_TAG=latest

# Application Settings
DEBUG=False

# Server Configuration
MASTER_PORT=5001

# API Key for Node authentication (use secure random keys in production)
MASTER_API_KEY=your-secure-master-api-key-here

# JWT Configuration (use secure random secrets in production)
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
USER_JWT_SECRET=your-secure-user-jwt-secret-here

# Database Configuration
# Example for PostgreSQL on same host:
#   DATABASE_URL=postgresql://master_user:master_password@localhost:5432/singalong_master
# Example for PostgreSQL on different host:
#   DATABASE_URL=postgresql://master_user:master_password@db.example.com:5432/singalong_master
DATABASE_URL=postgresql://master_user:master_password@db-host:5432/singalong_master

# Volume Paths (ensure directories exist on host)
MASTER_VIDEO_PATH=/var/singalong/master/videos
MASTER_LOG_PATH=/var/singalong/master/logs

# Database (if using Docker-managed PostgreSQL)
# MASTER_DB_USER=master_user
# MASTER_DB_PASSWORD=secure-db-password
# MASTER_DB_PORT=5432
