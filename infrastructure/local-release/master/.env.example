# Cloudflare Tunnel Token
# Get this from your Cloudflare dashboard
CLOUDFLARED_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database Configuration
DB_NAME=singalong_master
DB_USER=master_user
DB_PASSWORD=your-secure-password-here

# Application Debug Mode
DEBUG=False

# Master API Key for Node authentication
# Generate a secure random string (min 32 chars)
MASTER_API_KEY=your-secure-api-key-min-32-characters

# User JWT Secret for session tokens
# Generate a secure random string (min 32 chars)
USER_JWT_SECRET=your-secure-jwt-secret-min-32-characters
