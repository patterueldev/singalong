# Singalong Development Environment Variables
# Copy this file to .env and update values as needed

# ============================================
# Environment Configuration
# ============================================
ENVIRONMENT=development

# ============================================
# Master Service (Port 5001)
# ============================================
# Master service runs on port 5001
# API key(s) for service-to-service authentication (comma-separated for multiple keys)
# Minimum 8 characters per key
MASTER_API_KEY=dev-key

# ============================================
# Node Service (Port 5002)
# ============================================
# URL to reach the master service
# In Docker: http://master:5001
# On host machine: http://localhost:5001
MASTER_URL=http://master:5001

# ============================================
# Admin Dashboard (Port 3001)
# ============================================
# URL to reach the node service from the admin frontend
# In Docker: http://node:5002
# On host machine: http://localhost:5002
VITE_NODE_URL=http://localhost:5002

# ============================================
# Controller Frontend (Port 3002)
# ============================================
# API base URL for the controller
# In Docker: http://node:5002
# On host machine: http://localhost:5002
VITE_API_BASE_URL=http://localhost:5002

# ============================================
# Optional: Additional Configuration
# ============================================
# Add any other environment variables needed for your services here
# DEBUG=true
# LOG_LEVEL=debug

